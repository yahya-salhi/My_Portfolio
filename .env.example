# Copy to .env and fill from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Chatbot — OpenRouter key (server-side only; never prefix with VITE_)
# Get it at https://openrouter.ai/keys
# Required to build the RAG index (npm run build:rag) and to run /api/chat.
OPENROUTER_API_KEY=
# Optional: override the chat model served by /api/chat (default: openai/gpt-4o)
# CHAT_MODEL=openai/gpt-4o
